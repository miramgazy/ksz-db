# Django Configuration
DJANGO_SECRET_KEY=change-this-in-production-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Database (PostgreSQL)
POSTGRES_DB=ksz_db
POSTGRES_USER=ksz_user
POSTGRES_PASSWORD=ksz_password_secure123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Security: Fernet key for symmetric encryption of credentials
# Generate via: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FERNET_SECRET_KEY=generate-a-valid-fernet-key-here

# CORS & Frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80,http://localhost

# Superadmin Initial Credentials
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change_this_password
